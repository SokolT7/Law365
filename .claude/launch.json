    {
      "name": "ltblaw-public-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LTB_PUBLIC_DEMO=1",
        "VERCEL=1",
        "ANTHROPIC_API_KEY=",
        "npx",
        "next",
        "start",
        "-p",
        "3220"
      ],
      "port": 3220
    }
  ]
}