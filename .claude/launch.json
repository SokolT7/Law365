{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ltblaw",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3211"
      ],
      "port": 3211
    },
    {
      "name": "ltblaw-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/start-demo.mjs",
        "--port",
        "3010"
